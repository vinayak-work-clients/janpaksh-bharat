# Public origin used for sitemap.xml, robots.txt and absolute OG URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Protects /api/cron/purge. Vercel sends it as a bearer token automatically.
CRON_SECRET=replace-with-a-long-random-string

# Where public pages read from: mock (src/data/*) or supabase. Default mock.
DATA_SOURCE=mock
