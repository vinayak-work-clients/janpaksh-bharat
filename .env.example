# Public origin used for sitemap.xml, robots.txt and absolute OG URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Protects /api/cron/purge. Vercel sends it as a bearer token automatically.
CRON_SECRET=replace-with-a-long-random-string

# Where public pages read from: supabase (default) or mock (src/data/*, offline dev).
DATA_SOURCE=supabase

# Contact form email (optional). Without RESEND_API_KEY the message is still
# stored in contact_messages and the email step is skipped.
# RESEND_API_KEY=re_xxxxxxxx
# Sender shown on the notification; the domain must be verified in Resend.
# CONTACT_FROM_EMAIL="Janpaksh Bharat <noreply@yourdomain.com>"
# Where notifications go. Defaults to the contact email set in the dashboard.
# CONTACT_NOTIFY_EMAIL=desk@yourdomain.com
